{
 "total": 127.45,
 "rows": [
  {
   "id": "1.1",
   "start": 0.5,
   "end": 4.55,
   "plan": [
    0.5,
    4.0
   ],
   "text": "שלום! אנחנו ליבי ונעמי, ואנחנו מאוד אוהבות אמנות."
  },
  {
   "id": "1.2",
   "start": 4.67,
   "end": 6.28,
   "plan": [
    4.0,
    6.5
   ],
   "text": "תכירו את יעקב אגם!"
  },
  {
   "id": "2.1",
   "start": 6.5,
   "end": 11.47,
   "plan": [
    6.5,
    11.0
   ],
   "text": "הוא היה אמן ישראלי, מפורסם בכל העולם, ואחד ממייסדי האמנות הקינטית."
  },
  {
   "id": "2.2",
   "start": 11.59,
   "end": 14.97,
   "plan": [
    11.0,
    14.0
   ],
   "text": "זו אמנות שזזה, או שמשתנה כשזזים לידה."
  },
  {
   "id": "2.3",
   "start": 15.09,
   "end": 17.39,
   "plan": [
    14.0,
    16.5
   ],
   "text": "הסוד שלו: קפלים, כמו במניפה."
  },
  {
   "id": "2.4",
   "start": 17.51,
   "end": 21.15,
   "plan": [
    16.5,
    21.0
   ],
   "text": "על צד אחד תמונה אחת, ועל הצד השני, תמונה אחרת."
  },
  {
   "id": "2.5",
   "start": 21.27,
   "end": 23.16,
   "plan": [
    21.0,
    23.0
   ],
   "text": "כל צעד, ציור חדש!"
  },
  {
   "id": "3.1",
   "start": 23.28,
   "end": 28.19,
   "plan": [
    23.0,
    28.0
   ],
   "text": "ויש לו יצירה גדולה, בכיכר דיזנגוף בתל אביב: המזרקה \"אש ומים\"."
  },
  {
   "id": "3.2",
   "start": 28.31,
   "end": 32.01,
   "plan": [
    28.0,
    31.5
   ],
   "text": "היו בה חמש טבעות ענקיות, עם פאות משננות."
  },
  {
   "id": "3.3",
   "start": 32.13,
   "end": 37.59,
   "plan": [
    31.5,
    36.0
   ],
   "text": "פעם, הטבעות שבאמצע הסתובבו לאט, המים רקדו, ולמעלה בערה אש."
  },
  {
   "id": "3.4",
   "start": 37.71,
   "end": 39.53,
   "plan": [
    36.0,
    38.0
   ],
   "text": "אש ומים, ביחד!"
  },
  {
   "id": "4.1",
   "start": 39.65,
   "end": 42.66,
   "plan": [
    38.0,
    41.5
   ],
   "text": "והאש הזאת הזכירה לנו את חנוכה, חג האור!"
  },
  {
   "id": "4.2",
   "start": 42.78,
   "end": 47.46,
   "plan": [
    41.5,
    47.0
   ],
   "text": "וגם אגם עצמו עיצב חנכיה, בניו יורק. היא נחשבת לגדולה בעולם."
  },
  {
   "id": "4.3",
   "start": 47.58,
   "end": 52.02,
   "plan": [
    47.5,
    52.0
   ],
   "text": "ביוני השנה, יעקב אגם הלך לעולמו, ורצינו לעשות לו מחווה."
  },
  {
   "id": "4.4",
   "start": 52.14,
   "end": 56.32,
   "plan": [
    52.0,
    55.5
   ],
   "text": "ואז עלה לנו רעיון: להפוך את המזרקה שלו לחנכיה!"
  },
  {
   "id": "5.1",
   "start": 56.44,
   "end": 58.3,
   "plan": [
    55.5,
    57.5
   ],
   "text": "קודם כול, ישבנו ללמוד."
  },
  {
   "id": "5.2",
   "start": 58.42,
   "end": 62.69,
   "plan": [
    57.5,
    62.5
   ],
   "text": "קראנו על אגם, ולמדנו על הסגנון המיוחד שלו, שאין עוד אחד כמוהו."
  },
  {
   "id": "6.1",
   "start": 62.81,
   "end": 64.64,
   "plan": [
    62.5,
    64.5
   ],
   "text": "ואז הגיע תור הAI."
  },
  {
   "id": "6.2",
   "start": 64.76,
   "end": 68.82,
   "plan": [
    64.5,
    69.0
   ],
   "text": "ביקשנו ממנו עזרה, והוא בנה לנו דגמים בתלתממד לכל החלקים."
  },
  {
   "id": "6.3",
   "start": 69.0,
   "end": 73.45,
   "plan": [
    69.0,
    75.0
   ],
   "text": "הוא גם הראה לנו איך החנוכייה תראה בסוף, וכתב הוראות צביעה לכל פס."
  },
  {
   "id": "6.4",
   "start": 75.0,
   "end": 78.96,
   "plan": [
    75.0,
    78.5
   ],
   "text": "ואפילו הסרט הזה, שאתם רואים עכשיו, נעשה בעזרת AI!"
  },
  {
   "id": "7.1",
   "start": 79.08,
   "end": 84.86,
   "plan": [
    78.5,
    84.0
   ],
   "text": "ומה יצא? חנוכייה שהיא מחווה למזרקה: חמש טבעות עם פאות משננות, כמו שלה."
  },
  {
   "id": "7.2",
   "start": 84.98,
   "end": 87.89,
   "plan": [
    84.0,
    87.5
   ],
   "text": "ובתוך הפאות, הסתרנו סמלים של חג החנוכה."
  },
  {
   "id": "7.3",
   "start": 88.01,
   "end": 93.43,
   "plan": [
    87.5,
    92.5
   ],
   "text": "מצד אחד מתגלים מגן דוד וסביבון, ומהצד השני, המילה חנוכה וסופגנייה."
  },
  {
   "id": "7.4",
   "start": 93.55,
   "end": 98.09,
   "plan": [
    92.5,
    97.0
   ],
   "text": "כל פעם שזזים, מגלים משהו אחר, בדיוק כמו באמנות הקינטית של אגם!"
  },
  {
   "id": "8.1",
   "start": 98.21,
   "end": 104.64,
   "plan": [
    97.0,
    103.0
   ],
   "text": "ועכשיו, מהמחשב לעולם האמיתי: הדפסנו את כל החלקים במדפסת תלתממד, מפלסטיק ממוחזר."
  },
  {
   "id": "9.1",
   "start": 104.76,
   "end": 107.03,
   "plan": [
    103.0,
    105.5
   ],
   "text": "והחלק הכי כיפי? לצבוע!"
  },
  {
   "id": "9.2",
   "start": 107.15,
   "end": 109.93,
   "plan": [
    105.5,
    108.5
   ],
   "text": "צבענו ביד ארבע מאות ושמונה פסים."
  },
  {
   "id": "9.3",
   "start": 110.05,
   "end": 113.63,
   "plan": [
    108.5,
    112.0
   ],
   "text": "ובסוף הרכבנו הכול, טבעת על טבעת, כמו במזרקה."
  },
  {
   "id": "10.1",
   "start": 113.75,
   "end": 116.23,
   "plan": [
    112.0,
    115.0
   ],
   "text": "וכך נולדה חנכית \"אש ומים\"."
  },
  {
   "id": "10.2",
   "start": 116.35,
   "end": 121.38,
   "plan": [
    115.0,
    119.5
   ],
   "text": "החנוכייה שלנו היא מחווה, מתנה קטנה מאיתנו ליעקב אגם,"
  },
  {
   "id": "10.3",
   "start": 121.5,
   "end": 125.72,
   "plan": [
    119.5,
    122.5
   ],
   "text": "כדי שהאש שלו תמשיך לבעור, נר אחרי נר."
  },
  {
   "id": "10.4",
   "start": 125.84,
   "end": 127.45,
   "plan": [
    122.5,
    129.5
   ],
   "text": "חג חנוכה שמח!"
  }
 ]
