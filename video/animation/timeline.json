  "subtitles": [
    {
      "start": 0.37,
      "end": 2.358,
      "text": "קוראים לו יעקב אגם."
    },
    {
      "start": 2.469,
      "end": 6.368,
      "text": "הוא היה אמן ישראלי,\nוהשנה הוא הלך לעולמו."
    },
    {
      "start": 6.479,
      "end": 9.647,
      "text": "הוא יצר ציורים\nשנראים אחרת מכל צד."
    },
    {
      "start": 10.37,
      "end": 12.435,
      "text": "הוא קיפל משטח לפסים."
    },
    {
      "start": 12.701,
      "end": 16.931,
      "text": "מצד אחד רואים תמונה אחת.\nמהצד השני, תמונה אחרת."
    },
    {
      "start": 17.197,
      "end": 19.338,
      "text": "לזה קוראים פולימורף."
    },
    {
      "start": 20.37,
      "end": 23.701,
      "text": "בתל אביב, בכיכר\nדיזנגוף, יש מזרקה שלו."
    },
    {
      "start": 23.721,
      "end": 25.493,
      "text": "קוראים לה \"אש ומים\"."
    },
    {
      "start": 25.513,
      "end": 28.253,
      "text": "נחנכה ב־1986."
    },
    {
      "start": 28.273,
      "end": 30.949,
      "text": "היו בה חמש טבעות\nגדולות עם שיניים."
    },
    {
      "start": 31.37,
      "end": 37.115,
      "text": "בגרסה המקורית הטבעות סבבו, המים\nקפצו, ומלמעלה עלתה להבת אש."
    },
    {
      "start": 37.423,
      "end": 39.542,
      "text": "אש ומים, יחד."
    },
    {
      "start": 40.37,
      "end": 42.876,
      "text": "והאש הזאת הזכירה לנו חג."
    },
    {
      "start": 43.152,
      "end": 45.759,
      "text": "חג האור והאש: חנוכה!"
    },
    {
      "start": 46.036,
      "end": 49.679,
      "text": "רצינו לקחת את האש מהמזרקה\nולהפוך אותה לנרות."
    },
    {
      "start": 49.956,
      "end": 55.06,
      "text": "וגם אגם עצמו עיצב את החנוכייה\nשנחשבת הגדולה בעולם, בניו יורק."
    },
    {
      "start": 56.37,
      "end": 57.558,
      "text": "קודם למדנו."
    },
    {
      "start": 57.578,
      "end": 60.848,
      "text": "קראנו על אגם וחקרנו\nאיך המזרקה עובדת."
    },
    {
      "start": 60.868,
      "end": 64.356,
      "text": "למדנו שאגם אוהב\nפסים, צבעים ולבן."
    },
    {
      "start": 64.376,
      "end": 67.068,
      "text": "אז תכננו לכל טבעת צבעים משלה."
    },
    {
      "start": 67.37,
      "end": 68.531,
      "text": "ניסינו משהו חדש:"
    },
    {
      "start": 68.551,
      "end": 72.576,
      "text": "ביקשנו מבינה מלאכותית לבנות\nאת כל הדגמים והעיצובים."
    },
    {
      "start": 73.096,
      "end": 75.342,
      "text": "תוכנית צבעים, ואפילו לוגו."
    },
    {
      "start": 78.37,
      "end": 80.443,
      "text": "ומה יצא?"
    },
    {
      "start": 80.463,
      "end": 82.194,
      "text": "חנוכייה עם שתי תמונות!"
    },
    {
      "start": 82.214,
      "end": 86.044,
      "text": "מצד אחד מגן דוד וסביבון,\nמהצד השני סופגנייה."
    },
    {
      "start": 86.064,
      "end": 88.137,
      "text": "תלוי מאיפה אנחנו מסתכלים."
    },
    {
      "start": 88.37,
      "end": 90.755,
      "text": "הדפסנו הכול במדפסת תלת־ממד."
    },
    {
      "start": 90.775,
      "end": 94.24,
      "text": "הפלסטיק כבר היה בשימוש,\nונתנו לו חיים חדשים."
    },
    {
      "start": 94.26,
      "end": 97.876,
      "text": "כל חלק הודפס בדיוק\nבכמות שצריך, בלי פסולת."
    },
    {
      "start": 98.37,
      "end": 102.568,
      "text": "ואז צבענו ביד, פס\nאחרי פס, והרכבנו הכול."
    },
    {
      "start": 103.088,
      "end": 105.414,
      "text": "ארבע מאות ושמונה פאות!"
    },
    {
      "start": 108.37,
      "end": 111.19,
      "text": "וכך נולדה חנוכיית\n\"אש ומים\":",
      "x": 520,
      "plate": true
    },
    {
      "start": 111.323,
      "end": 115.459,
      "text": "האש של המזרקה, בצבעים\nשל אגם, מפלסטיק ממוחזר.",
      "x": 520,
      "plate": true
    },
    {
      "start": 115.592,
      "end": 117.603,
      "text": "חג חנוכה שמח!",
      "x": 520,
      "plate": true
    }
  ],
